# PhanthyWork2API — OpenAI-compatible proxy for PhanthyCode

# === PhanthyCode Auth (OAuth PKCE) ===
# 本网关通过 OAuth PKCE 流程换取 token，支持网页登录自动续期。
# 启动后打开 http://<服务器>:<端口>/admin 控制台，在「系统」页点击「网页登录」
# 用手机号/微信登录 PhanthyCode 账号，token 会自动保存到 auths/ 目录。
# 多账号支持：在控制台「账号池」页添加额外账号，每个账号独立 token。

# === Admin Panel Password (控制台登录密码) ===
# 浏览器打开 /admin 时的登录密码。强烈建议设置独立强密码。
# 未设置时，控制台暂时沿用 API_KEY（启动日志会告警）。
ADMIN_PASSWORD=admin-change-me

# === Client API Key（客户端调用密钥）===
# 调用 /v1/chat/completions 和 /v1/models 时的 Bearer Token。
# 对外暴露务必设置，防止被刷额度。
P2A_API_KEY=sk-custom-your-key

# === Server Configuration ===
P2A_LISTEN=:7864

# === Auth & State Files ===
P2A_AUTH_DIR=./auths
P2A_STATE_FILE=./data/state.json
P2A_CLAIMS_FILE=./data/claims.json

# === Upstream ===
P2A_BASE_URL=https://code.phanthy.com
P2A_TIMEOUT_SECONDS=600

# === Proxy (One account, one IP) ===
# 全局默认代理；Resin 等代理池写：http://Platform.Account:token@host:port
# P2A_PROXY_URL=http://Default.phanthy_acc1:token@resin-host:8080
# 账号级代理（覆盖全局），格式 uid1=url1,uid2=url2
# P2A_PROXY_BY_ACCOUNT=acc1=http://Default.acc1:t@host:8080,acc2=http://Default.acc2:t@host:8080

# === Auto Check-in (Daily rewards) ===
# 每天定时调用 PhanthyCode 每日签到接口领取积分。
# P2A_CLAIM_HOURS=8

# === Safety (Account protection) ===
P2A_DAILY_LIMIT=0
P2A_CONCURRENCY=1
P2A_JITTER_MAX=300ms
P2A_MAX_ROTATE=3

# === Headers aligned with official PhanthyCode CLI ===
P2A_ANTHROPIC_VERSION=2023-06-01
P2A_BETA=oauth-2025-04-20
